{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "!src/**/*.stories.tsx",
        "!src/**/*.test.{ts,tsx}",
        "!src/tests/**",
        "index.html",
        "vite.config.ts",
        "tsconfig*.json",
        "package.json"
      ],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "eslint.config.js"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "jest.config.cjs", "babel.config.cjs"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "jest.config.cjs", "babel.config.cjs"],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:mock": {
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    }
  }
}
